# ──────────────────────────────────────────────────────────────
#  Evoque Assets — PRODUCTION environment
#  Copy to ".env" on the server and fill in real values.
#  Never commit the real .env.
# ──────────────────────────────────────────────────────────────

# Django ───────────────────────────────────────────────────────
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string

DEBUG=False

# Space/comma list of hostnames+IPs this site answers on.
# IP-only for now; add your domain later.
ALLOWED_HOSTS=127.0.0.1,localhost,YOUR_SERVER_IP

# Needed so the admin login form (a CSRF-protected POST) is accepted.
# Must include scheme AND the exact port you expose. Example for port 8003:
CSRF_TRUSTED_ORIGINS=http://YOUR_SERVER_IP:8003

# Leave these False on plain http://IP:PORT. Flip to True only AFTER you
# put the site behind a domain with HTTPS — otherwise you can't log in.
SECURE_SSL_REDIRECT=False
SECURE_COOKIES=False

# PostgreSQL ───────────────────────────────────────────────────
DB_NAME=realestate_db
DB_USER=realestate_user
DB_PASSWORD=use-a-strong-password-here
DB_HOST=localhost
DB_PORT=5432
